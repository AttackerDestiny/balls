return function(source)
    local make=assert(loadstring(source))()
    local pace=make("test-run")
    local range={Min=35,Max=38}
    local hold,goal=pace(range,50,"00:10:00",20,false)
    assert(hold and goal>=2100 and goal<=2280)
    assert(select(2,make("test-run")(range,50,"00:10:00",20,false))==goal,"Accounts share a goal")
    local other=select(2,make("another-run")(range,50,"00:10:00",20,false))
    assert(other>=2100 and other<=2280 and other~=goal,"Runs can select different minutes and seconds")
    assert(not pace(range,50,"00:10:00",20,true),"Do not stall survival waves")
    assert(not pace(range,50,"00:20:00",20,false),"Fight at normal speed when behind")
    assert(pace(range,100,"00:34:59",1,false,.1),"Delay finishing damage when the final boss is low")
    assert(not pace(range,100,"00:38:00",1,false,.1))
    assert(select(2,pace({Min=100,Max=100},1,"00:00:00",1,false))==6000)
    assert(not pace({Min=0,Max=0},100,"00:00:00",1,false))
    print("PASS Between pacing: shared range goals, catch-up, survival, final wave and cap")
end
