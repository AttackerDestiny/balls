return function(source)
    local make=assert(loadstring(source))()
    local pace=make("test-run")
    local hold,goal=pace(35,50,"00:10:00",20,false)
    assert(hold and goal>2100 and goal<2160)
    assert(select(2,make("test-run")(35,50,"00:10:00",20,false))==goal,"Accounts share a goal")
    assert(not pace(35,50,"00:10:00",20,true),"Do not stall survival waves")
    assert(not pace(35,50,"00:20:00",20,false),"Fight at normal speed when behind")
    assert(pace(35,100,"00:34:59",1,false,.1),"Delay finishing damage when the final boss is low")
    assert(not pace(35,100,"00:36:00",1,false,.1))
    assert(select(2,pace(100,1,"00:00:00",1,false))==6000)
    assert(not pace(0,100,"00:00:00",1,false))
    print("PASS Between pacing: shared random seconds, catch-up, survival, final wave and cap")
end
